# Copy to .env for docker compose. Never commit .env.

# "local" leaves the admin pages open when no admin password is set.
# Anything else (and the default inside the image) is production: the admin
# pages stay closed until a password is configured.
APP_ENV=local

POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=appdb

# Admin login for the CSV import and table pages (HTTP Basic auth).
# Prefer a hash: php -r 'echo password_hash("your-password", PASSWORD_DEFAULT), "\n";'
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
